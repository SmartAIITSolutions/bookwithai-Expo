{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "ios-simulator": {
      "extends": "production",
      "ios": {
        "simulator": true
      },
      "channel": "ios-simulator"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6793853590",
        "appleTeamId": "6ZATGS9FC8"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "alpha"
      }
    }
  }
}
